<h2 class="text-gray-900 font-bold text-2xl mb-4">Change your password</h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "users/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="field mb-4">
    <%= f.label :password, "New password", class: "text-gray-800 font-medium" %><br />
    <% if @minimum_password_length %>
      <em class="text-gray-600">(<%= @minimum_password_length %> characters minimum)</em><br />
    <% end %>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "border rounded p-2 text-gray-900" %>
  </div>

  <div class="field mb-4">
    <%= f.label :password_confirmation, "Confirm new password", class: "text-gray-800 font-medium" %><br />
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "border rounded p-2 text-gray-900" %>
  </div>

  <div class="actions">
    <%= f.submit "Change my password", class: "bg-blue-600 text-white px-4 py-2 rounded" %>
  </div>
<% end %>

<%= render "users/shared/links" %>
